[TEMPLATE]
PWIOI_ATTENDANCE_URL=https://app.pwioi.club/dashboard/student/attendance
BROWSER_PROFILE_DIR=browser-profile
DATABASE_URL=sqlite:///./data/attendance.db

# Daily attendance check time (24h HH:MM) in TIMEZONE. Default: 4:30 PM.
CHECK_TIME=16:30
TIMEZONE=Asia/Kolkata

# Google OAuth credentials for Gmail sending (never commit these files).
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GMAIL_TOKEN_FILE=data/gmail_token.json

LOG_LEVEL=INFO
HEADLESS=false
